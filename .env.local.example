# =============================================
# Supabase 設定
# Supabaseダッシュボード > Project Settings > API から取得
# =============================================

# プロジェクトURL（例: https://xxxxxxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# anon公開キー（フロントエンドから安全に使える）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# サービスロールキー（サーバーサイドのみ。絶対にフロントに露出させないこと）
# Supabaseダッシュボード > Project Settings > API > service_role から取得
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================
# アプリ設定
# =============================================

# サイトURL（ローカル開発時: http://localhost:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# cron エンドポイント（/api/cron/*）の認証用シークレット。未設定の場合は常に401を返す
CRON_SECRET=

# =============================================
# Gmail 連携（受信メール機能）※すべてサーバー専用。NEXT_PUBLIC_ を付けないこと
# 設定手順: docs/GMAIL_SETUP.md
# 値は Vercel の環境変数にのみ登録し、リポジトリ・チャット・Issue には貼らない
# =============================================

# サービスアカウントのメールアドレス
GMAIL_SA_CLIENT_EMAIL=

# サービスアカウントの秘密鍵（JSON の private_key の値。改行は \n 表記のまま1行で登録してよい）
GMAIL_SA_PRIVATE_KEY=

# 読み取り対象のメールボックス（ドメイン全体の委任で impersonate する代表アドレス）
GMAIL_IMPERSONATE_USER=

# 初回／フォールバック時に取り込む日数（任意。既定 30）
GMAIL_INITIAL_SYNC_DAYS=

# 開発・検証専用: 1 にすると架空データのフィクスチャで動作（本番環境では無視される）
GMAIL_FIXTURE_MODE=
